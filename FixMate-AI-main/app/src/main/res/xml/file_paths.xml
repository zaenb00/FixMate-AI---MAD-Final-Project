<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the FileProvider is allowed to expose as content:// URIs. -->
<paths>
    <!-- Images captured by the camera are stored in the app's private cache. -->
    <cache-path name="captured_images" path="images/" />
    <!-- Exported report PDFs. -->
    <cache-path name="exported_pdfs" path="pdfs/" />
    <external-cache-path name="external_images" path="images/" />
    <external-files-path name="my_images" path="Pictures/" />
</paths>
